# Copy to .env and fill in. Read by docker-compose (legacy Docker path only;
# real deploys use jkbase secrets — see DEPLOY.md). .env is gitignored.

# Resend API key. Leave empty to disable email (password reset + feedback
# notifications become no-ops; the app still runs).
RESEND_API_KEY=

# Public base URL used in emailed links (e.g. password-reset links).
APP_URL=https://pw.lostconnection.dev

# From address for outgoing mail.
RESEND_FROM=PlotWeb <plotweb@noreply.lostconnection.dev>
