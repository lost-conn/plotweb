/target
plotweb-web/target
plotweb-web/dist/
*.db
*.db-shm
*.db-wal
data/
deploy.log

# Local secrets / env (docker-compose reads this; never commit it)
.env

# Claude Code — local machine state (per-user settings + agent git worktrees)
.claude/settings.local.json
.claude/worktrees/

# Android — generated build output, Gradle/Kotlin caches, and IDE files.
# No Android source is tracked in this repo; the dir is build artifacts only.
android/.gradle/
android/.kotlin/
android/.idea/
android/build/
android/app/build/
android/captures/
android/local.properties
android/**/*.iml

# Playwright artifacts from an e2e run launched inside the crate dir
plotweb-web/test-results/

# Browser MCP scratch dumps (console logs + page snapshots) from a driven session
.playwright-mcp/

# mold linker opt-in — generated per-clone by ./scripts/setup-mold.sh.
# Deliberately NOT committed: jkbase builds in a sealed offline buildpack VM
# with no mold, and a committed config would fail that deploy at link time.
.cargo/config.toml

# Written by the e2e launch script so a spec can find the throwaway stores.
e2e/.e2e-state
